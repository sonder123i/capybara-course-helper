{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academic-assistant-usage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "account_id": "04f77370f1443cb98e7346a64202ca28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "usage.hidisiwa.xyz", "custom_domain": true },
    { "pattern": "stats.hidisiwa.xyz", "custom_domain": true }
  ],
  "vars": {
    "USAGE_HOST": "usage.hidisiwa.xyz",
    "STATS_HOST": "stats.hidisiwa.xyz",
    "ACCESS_TEAM_DOMAIN": "zhengfangqk-pages.cloudflareaccess.com",
    "ACCESS_AUD": "1b03cb3e790af69c4954d5525a08d5e21c272fa80509137c387ba4156d15e9a0",
    "ADMIN_EMAIL": "822069905@qq.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "academic-assistant-usage",
    "database_id": "6f30024e-776a-481e-90e7-347df31330b0",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "USAGE_IP_LIMITER", "namespace_id": "10911001", "simple": { "limit": 120, "period": 60 } },
    { "name": "USAGE_INSTALL_LIMITER", "namespace_id": "10911002", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
